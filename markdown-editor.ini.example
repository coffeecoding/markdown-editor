; Copy to markdown-editor.ini beside markdown-editor.exe.
; Mode > Dark theme applies and saves theme changes immediately.
[appearance]
theme=light

; Saved changes apply live after 150 ms. Use #RRGGBB (case-insensitive).
; Missing entries use built-in defaults while running.
; Invalid background/code colors use #8B0000; other colors use #FF69B4.
; A confirmed close repairs missing/invalid entries to normal defaults.
; table_border is a fixed RGB color, independent of text and background.
[theme.light]
background=#F5F3EE
text=#242424
link=#005BAE
muted=#62605C
code=#E8E5DE
table_border=#C1BFB9

[theme.dark]
background=#000000
text=#D0D0D0
link=#79B8FF
muted=#A0A0A0
code=#181818
table_border=#484848

; Installed Windows font families; saved changes apply live.
; Independent source, preview prose, and preview code fonts. Sizes are fixed.
; Missing entries use these defaults; invalid/empty families use Consolas.
[font]
edit=Consolas
prose=Segoe UI
code=Consolas
