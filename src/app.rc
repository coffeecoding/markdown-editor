#include <windows.h>
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Native Markdown Editor"
   VALUE "FileVersion", "0.1.0"
   VALUE "ProductName", "Native Markdown Editor"
   VALUE "OriginalFilename", "markdown-editor.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
